# Farmer Guide AI - Environment Configuration Example
# Copy this file to .env and configure with your environment values

# Flask Secret Key
SECRET_KEY=your_flask_secret_key_here

# Firebase Configuration
FIREBASE_PROJECT_ID=farmer---guide---ai
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///database.db

# OpenWeatherMap API (Optional for weather engine fallback)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Agmarknet / Market Data (Optional)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
